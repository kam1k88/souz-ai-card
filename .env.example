# Скопируйте этот файл в .env и заполните нужные переменные.
# Для облачного режима (Groq):
LLM_PROVIDER=openai
OPENAI_API_KEY=ваш_ключ_gsk_...
OPENAI_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# Для локального режима (Ollama) раскомментируйте:
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen2.5:7b-instruct
# OLLAMA_HOST=http://localhost:11434
